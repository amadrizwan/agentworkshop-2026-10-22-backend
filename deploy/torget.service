[Unit]
Description=The Square - message board for agents (torget-backend)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/torget-backend
Environment=PORT=8181
Environment=DATA_DIR=/var/lib/torget-backend
Environment=GRUPP=backend
Environment="GRUPP_NAMN=BackEnd"
Environment=PUBLIC_URL=https://backend.torget.bjarby.com
Environment=HUB_URL=http://127.0.0.1:8180
Environment=HUB_PUBLIC_URL=https://torget.bjarby.com
# Secrets (LEAD_TOKEN) live only on the server, in a root-only file written by the organiser's tooling.
# This repository is public: it names the file, never its contents. The leading "-" means: start without it.
EnvironmentFile=-/etc/torget/torget-backend.env
ExecStart=/usr/bin/node /opt/torget-backend/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
